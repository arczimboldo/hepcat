# Maintainer: arczimboldo <https://github.com/arczimboldo>

pkgname=hepcat-git
pkgver=0.1.0.r1.g66d762e
pkgrel=1
pkgdesc='Voicemeeter-style audio mixer for PipeWire with effects and a native KDE Plasma look'
arch=('x86_64' 'aarch64')
url='https://github.com/arczimboldo/hepcat'
license=('MIT')
depends=(
  'glibc'
  'kirigami'
  'libgcc'
  'libpipewire'
  'libstdc++'
  'pipewire'
  'qqc2-desktop-style'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'webrtc-audio-processing-1'
  'wireplumber'
)
makedepends=('cargo' 'clang' 'git' 'pkgconf')
provides=('hepcat')
conflicts=('hepcat')
# GCC LTO objects from the C++ parts cannot be linked by Rust's lld.
options=('!lto')
install=hepcat.install
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Before the first tag, count commits on top of 0.1.0.
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  ) || printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Keep the build directory out of the binary (C++ assertions embed file names).
  export CXXFLAGS+=" -ffile-prefix-map=$srcdir=/usr/src/debug"
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/hepcat -t "$pkgdir/usr/bin"
  install -Dm644 io.github.arczimboldo.Hepcat.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 io.github.arczimboldo.Hepcat.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 icons/hepcat.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.arczimboldo.Hepcat.svg"
  install -Dm644 icons/hepcat-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.arczimboldo.Hepcat-symbolic.svg"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
